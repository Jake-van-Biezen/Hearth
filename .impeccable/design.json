  "narrative": {
    "northStar": "The Kitchen Wall Planner",
    "overview": "Hearth renders as the artifact it replaces: a ruled paper wall planner hung where the whole family looks twice a day. Warm undyed paper ground with a fine blue lattice at 26px, a red margin line down the left, marker voice for the family name, quiet Karla for everything read twice. Color does jobs, never decoration; controls stay standard web.",
    "keyCharacteristics": [
      "Ruled-paper ground with red margin line; content indents past it.",
      "Marker-weight display face for the family name and day labels only.",
      "Standard controls in their own shared grammar.",
      "Chips carry events in saturated marker colors; color is information.",
      "One authored motion moment per surface: paper hangs and settles.",
      "Light only \u2014 paper is a daylight material."
    ],
    "rules": [
      {
        "name": "The Standard-Control Rule",
        "body": "Layout, navigation, and controls are always standard web components; the planner world never costumes a control.",
        "section": "colors"
      },
      {
        "name": "The Margin-Line Rule",
        "body": "The red margin line runs the full height of any sheet-like surface at 34px; content indents to 56px or more.",
        "section": "layout"
      },
      {
        "name": "The One Hand Rule",
        "body": "Permanent Marker appears at most twice on any screen \u2014 one display voice, one label layer; body copy is always Karla.",
        "section": "typography"
      },
      {
        "name": "The 11px Floor Rule",
        "body": "No functional text renders under 11px.",
        "section": "typography"
      }
    ],
    "dos": [
      "Do keep every interaction control a standard web component in its own familiar grammar.",
      "Do draw color at page-scale jobs: chips carry events, the margin frames the week.",
      "Do self-host both faces and settle motion with cubic-bezier(0.22, 1, 0.36, 1) from a visible default.",
      "Do theme the browser surfaces from the palette."
    ],
    "donts": [
      "Don't costume a control as a household object.",
      "Don't use marker display type for anything the task depends on reading twice.",
      "Don't darken the paper for a dark mode.",
      "Don't invent placeholder data with claims."
    ]
  }
}