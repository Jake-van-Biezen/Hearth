# Push notifications (copy to deploy/.env for local dev; on the NAS these
# live in /volume1/docker/stacks/.env). Generate VAPID keys once with:
#   npx web-push generate-vapid-keys
# Rotating them invalidates every device's subscription (members re-enable).
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com

# Superuser the push sidecar logs in as. Created/updated by pb_hooks/push.pb.js
# on every PocketBase boot, so changing the password is: edit, restart.
HEARTH_PUSH_EMAIL=push@hearth.local
HEARTH_PUSH_PASSWORD=

# Family membership (pb_hooks/membership.pb.js). These emails join the family
# automatically when they first sign in (case-insensitive, comma-separated);
# anyone else sees "not part of a family yet". Every member also gets a
# personal calendar only they can see.
HEARTH_FAMILY_EMAILS=
# Which family they join. Optional while there is only one family.
HEARTH_FAMILY_ID=
