{
	"name": "hearth",
	"private": true,
	"version": "0.0.1",
	"packageManager": "pnpm@11.3.0",
	"type": "module",
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"pb:up": "docker compose -f deploy/docker-compose.yml up -d",
		"pb:down": "docker compose -f deploy/docker-compose.yml down",
		"pb:reset": "docker compose -f deploy/docker-compose.yml down && rm -rf deploy/pb_data"
	},
	"devDependencies": {
		"@fontsource-variable/inter": "^5.3.0",
		"@lucide/svelte": "^1.59.0",
		"@sveltejs/adapter-static": "^4.0.0",
		"@sveltejs/kit": "^2.63.0",
		"@sveltejs/vite-plugin-svelte": "^7.1.2",
		"@tailwindcss/vite": "^4.3.0",
		"@types/node": "^24",
		"@vite-pwa/sveltekit": "^1.1.0",
		"shadcn-svelte": "^1.6.1",
		"svelte": "^5.56.1",
		"svelte-check": "^4.6.0",
		"svelte-sonner": "^1.2.1",
		"tailwind-variants": "^3.3.1",
		"tailwindcss": "^4.3.0",
		"typescript": "^6.0.3",
		"vite": "^8.0.16",
		"vite-plugin-pwa": "^1.3.0",
		"workbox-window": "^7.4.1"
	},
	"dependencies": {
		"@fontsource-variable/karla": "^5.3.0",
		"@fontsource/permanent-marker": "^5.3.0",
		"bits-ui": "^2.19.0",
		"clsx": "^2.1.1",
		"pocketbase": "^0.28.1",
		"tailwind-merge": "^3.6.0",
		"tw-animate-css": "^1.4.0"
	}
}
